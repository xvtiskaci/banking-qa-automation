# Safe example configuration — copy to .env and use only local/test credentials.
# Environment variables from PowerShell, PyCharm or Jenkins override .env.
# Never commit real passwords, bank account details, SMS/TAN codes or SSH keys.

# Browser settings
BROWSER=chrome
HEADLESS=false

# ParaBank DEMO environment (local Tomcat / demo app)
PARABANK_BASE_URL=http://localhost:8081/parabank
PARABANK_USERNAME=YOUR_DEMO_USERNAME
PARABANK_PASSWORD=YOUR_DEMO_PASSWORD
PARABANK_FROM_ACCOUNT=YOUR_FIRST_DEMO_ACCOUNT_ID
PARABANK_TO_ACCOUNT=YOUR_SECOND_DEMO_ACCOUNT_ID
PARABANK_TRANSFER_AMOUNT=1.00

# API base URL is optional; by default: PARABANK_BASE_URL/services/bank
# PARABANK_API_BASE_URL=http://localhost:8081/parabank/services/bank
# These two flags must remain disabled unless a demo API transfer is intentional.
PARABANK_API_TRANSFER_RUN=NO
PARABANK_API_ALLOW_PUBLIC=NO

# ProCredit REAL bank — all live actions are disabled by default.
PRO_CREDIT_BASE_URL=https://online.procreditbank.ge/login
PRO_CREDIT_RUN=0
PRO_CREDIT_USERNAME=YOUR_BANK_USERNAME

# PRO_CREDIT_PASSWORD is deliberately omitted. Use a process env variable,
# Windows Credential Manager or Jenkins Credentials, NEVER Git.
PRO_CREDIT_RECIPIENT_IBAN=YOUR_APPROVED_TEST_RECIPIENT_IBAN
PRO_CREDIT_RECIPIENT_NAME=YOUR_APPROVED_TEST_RECIPIENT_NAME
PRO_CREDIT_EXPECTED_BANK_NAME='სს "თიბისი ბანკი"'

# Android SMS OTP via ADB local forwarding to Termux SSH
TERMUX_SSH_USER=YOUR_TERMUX_USER
TERMUX_SSH_KEY=PATH_TO_YOUR_SSH_PRIVATE_KEY
PROCREDIT_SMS_SENDER=ProCredit

# This source project's current login/TAN configuration expects 4 digits.
# Change locally only if the real SMS format and tests match.
PROCREDIT_OTP_LENGTH=4

# DANGER: these switches can enable live-bank final-submit test execution.
# Never turn them on in a public CI job or without explicit authorization.
PRO_CREDIT_NEGATIVE_SUBMIT=NO
PRO_CREDIT_MOBILE_NEGATIVE_SUBMIT=NO
PRO_CREDIT_MANUAL_WARNING_CHECK=0
